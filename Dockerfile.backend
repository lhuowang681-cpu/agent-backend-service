FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
ARG PIP_INDEX_URL=https://pypi.org/simple
COPY requirements.backend.txt ./
RUN python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements.backend.txt
COPY pyproject.toml README.md ./
COPY src ./src
COPY fit_verdict_engine ./fit_verdict_engine
ENV PYTHONPATH=/app/src:/app

CMD ["python", "-m", "uvicorn", "job_agent.backend_service.persistent_main:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000"]
