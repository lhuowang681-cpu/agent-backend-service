# Copy names into the process environment before starting the live-only UI.
# Never commit real values. The application does not read glm.txt or accept a page-level key.
JOB_AGENT_LIVE_API_KEY=
JOB_AGENT_LIVE_BASE_URL=https://open.bigmodel.cn/api/anthropic
JOB_AGENT_LIVE_MODEL=glm-4.7

# Path to an approved runtime skill package containing SKILL.md and release-manifest.txt.
LLM_INTERN_SKILL_ROOT=

# Optional local output root. Runtime state and SQLite files remain ignored by Git.
JOB_AGENT_OUTPUT_ROOT=output/workbench
